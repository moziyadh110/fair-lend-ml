# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Required for FRED economic data ingestion module (data_engineering/ingest_fred.py)
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional. If set, monitoring/alerting.py posts fired alerts here (create
# one at https://api.slack.com/messaging/webhooks). Alerts are computed and
# logged either way; this just controls whether anyone gets notified.
SLACK_WEBHOOK_URL=

# Shared API key for serving/app.py's decision-making endpoints (/predict,
# /batch-score, /fairness-report). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Callers send it as the X-API-Key header. /health is intentionally public.
API_KEY=

# Postgres connection (defaults match docker-compose.yml, change only if you edit that file)
POSTGRES_DB=credit_default
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
